# ── Supabase (ücretsiz katman) ───────────────────────────────────────────────
# Supabase paneli > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://PROJE_KIMLIGI.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-veya-publishable-anahtar
# Yalnızca sunucuda (cron görevleri için). Asla NEXT_PUBLIC_ ile başlatma, depoya işleme.
SUPABASE_SERVICE_ROLE_KEY=service-role-anahtari

# Herkese açık kayıt kapalı kalsın: hesabı Supabase panelinden elle oluştur.
# Yalnızca ilk hesabı uygulamadan açmak istersen geçici olarak true yap.
NEXT_PUBLIC_ALLOW_SIGNUP=false

# ── Yapay zekâ geri bildirimi (hepsi isteğe bağlı, ücretsiz katman) ──────────
# En az biri tanımlıysa kullanılır; hiçbiri yoksa kural tabanlı yedek çalışır.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Yerel Ollama (isteğe bağlı yedek, ör. http://localhost:11434)
OLLAMA_URL=
OLLAMA_MODEL=llama3.1
# Günlük en fazla kaç geri bildirim isteği
FEEDBACK_DAILY_LIMIT=30

# ── Web Push (npm run vapid ile üret) ───────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sen@example.com

# ── Zamanlanmış görevler (GitHub Actions bu değeri başlıkta gönderir) ───────
CRON_SECRET=uzun-rastgele-bir-metin
